# OceanEmbed frontend configuration
# Copy to .env and fill in real values. Never commit .env.
# Get these from the Supabase dashboard: Project Settings -> API

# --- Server-side Supabase (used by server routes, APIs, auth middleware) ---
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxx

# --- Browser-exposed Supabase (VITE_ prefix is inlined into client bundles) ---
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# --- Google AI Studio: https://aistudio.google.com/apikey ---
GEMINI_API_KEY=your-gemini-api-key

# Optional: URL of the deployed Django backend (for backend status checks).
# Defaults to http://localhost:8000 when unset.
# BACKEND_BASE_URL=https://your-backend.example.com