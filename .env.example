# Django backend configuration
# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Supabase (required) ---
# Used to verify Supabase JWT bearer tokens from the frontend (api/supabase_auth.py)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Cache lifetime (seconds) for the Supabase JWKS signing keys (optional, default 600)
# SUPABASE_JWKS_CACHE_SECONDS=600

# --- Legacy Django email auth (optional; auth is handled by Supabase) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-gmail@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=your-gmail@gmail.com
# EMAIL_VERIFICATION_REQUIRED=true
